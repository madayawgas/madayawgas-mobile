{
  "$schema": "https://repomix.com/schemas/latest/schema.json",
  "output": {
    "filePath": "repomix-mobile.md",
    "style": "markdown",
    "fileSummary": true,
    "directoryStructure": true
  },
  "ignore": {
    "useGitignore": true,
    "useDefaultPatterns": true,
    "customPatterns": [
      "**/.agents/**",
      "**/.codex/**",
      "**/.claude/**",
      "**/.github/**",
      "**/.vscode/**",
      "**/.expo/**",
      "**/.gradle/**",
      "**/coverage/**",
      "**/build/**",
      "**/scratch/**",
      "**/*.log",
      ".env",
      ".env.*",
      "!.env.example",
      "**/*.min.js",
      "**/*.map"
    ]
  }
}
